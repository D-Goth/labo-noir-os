{
  "categories": [
    {
      "name": "🔍 Reconnaissance",
      "tools": [
        {
          "name": "Nmap",
          "description": "Scan de ports et détection de services",
          "command": "nmap",
          "params": [
            {"id": "target", "type": "text", "label": "Cible (IP / domaine)", "placeholder": "192.168.1.1"},
            {"id": "scan_type", "type": "dropdown", "label": "Type de scan", "options": ["-sS (Stealth)", "-sT (Connect)", "-sU (UDP)", "-sV (Version)"], "default": "-sS (Stealth)"},
            {"id": "port_scan", "type": "checkbox", "label": "Tous les ports (-p-)", "option": "-p-", "default": false},
            {"id": "os_detect", "type": "checkbox", "label": "Détection OS (-O)", "option": "-O", "default": false},
            {"id": "aggressive", "type": "checkbox", "label": "Scan agressif (-A)", "option": "-A", "default": false}
          ]
        },
        {
          "name": "Masscan",
          "description": "Scan de ports à très grande vitesse",
          "command": "masscan",
          "params": [
            {"id": "target", "type": "text", "label": "Cible (IP / plage)", "placeholder": "192.168.1.0/24"},
            {"id": "ports", "type": "text", "label": "Ports à scanner", "placeholder": "80,443,22,21", "default": "80,443,22"},
            {"id": "rate", "type": "text", "label": "Débit (paquets/s)", "placeholder": "1000", "default": "1000"}
          ]
        }
      ]
    },
    {
      "name": "🔐 Bruteforce & Auth",
      "tools": [
        {
          "name": "Hydra",
          "description": "Bruteforce sur protocoles réseau",
          "command": "hydra",
          "params": [
            {"id": "target", "type": "text", "label": "Cible (IP)", "placeholder": "192.168.1.1"},
            {"id": "service", "type": "dropdown", "label": "Service", "options": ["ssh", "ftp", "http-post-form", "smb", "rdp"], "default": "ssh"},
            {"id": "user_file", "type": "text", "label": "Fichier utilisateurs", "placeholder": "/usr/share/wordlists/users.txt"},
            {"id": "pass_file", "type": "text", "label": "Fichier mots de passe", "placeholder": "/usr/share/wordlists/passwords.txt"},
            {"id": "threads", "type": "text", "label": "Threads (-t)", "default": "4"}
          ]
        },
        {
          "name": "John the Ripper",
          "description": "Crack de mots de passe (hash)",
          "command": "john",
          "params": [
            {"id": "hash_file", "type": "text", "label": "Fichier de hash", "placeholder": "/path/to/hash.txt"},
            {"id": "wordlist", "type": "text", "label": "Wordlist (optionnel)", "placeholder": "/usr/share/wordlists/rockyou.txt"}
          ]
        }
      ]
    },
    {
      "name": "💉 Web & Exploit",
      "tools": [
        {
          "name": "SQLMap",
          "description": "Détection et exploitation d'injections SQL",
          "command": "sqlmap",
          "params": [
            {"id": "url", "type": "text", "label": "URL cible", "placeholder": "http://cible.com/page.php?id=1"},
            {"id": "level", "type": "dropdown", "label": "Intensité", "options": ["1 (Léger)", "2", "3 (Lourd)"], "default": "1 (Léger)"},
            {"id": "dbms", "type": "dropdown", "label": "SGBD", "options": ["Auto", "MySQL", "PostgreSQL", "Oracle", "MSSQL"], "default": "Auto"},
            {"id": "dbs", "type": "checkbox", "label": "Lister les bases (--dbs)", "option": "--dbs", "default": true},
            {"id": "tables", "type": "checkbox", "label": "Lister les tables (--tables)", "option": "--tables", "default": false}
          ]
        },
        {
          "name": "Nikto",
          "description": "Scan de vulnérabilités web",
          "command": "nikto",
          "params": [
            {"id": "target", "type": "text", "label": "URL cible", "placeholder": "http://cible.com"},
            {"id": "ssl", "type": "checkbox", "label": "Forcer HTTPS (-ssl)", "option": "-ssl", "default": false}
          ]
        }
      ]
    },
    {
      "name": "📶 Wi-Fi & Réseau",
      "tools": [
        {
          "name": "Aircrack-ng",
          "description": "Suite d'outils Wi-Fi (capture, crack)",
          "command": "aircrack-ng",
          "params": [
            {"id": "cap_file", "type": "text", "label": "Fichier .cap", "placeholder": "/path/to/capture.cap"},
            {"id": "wordlist", "type": "text", "label": "Wordlist", "placeholder": "/usr/share/wordlists/rockyou.txt"}
          ]
        },
        {
          "name": "Tcpdump",
          "description": "Capture de paquets réseau",
          "command": "tcpdump",
          "params": [
            {"id": "interface", "type": "text", "label": "Interface", "placeholder": "eth0", "default": "eth0"},
            {"id": "output", "type": "text", "label": "Fichier de sortie (.pcap)", "placeholder": "capture.pcap"}
          ]
        }
      ]
    },
    {
      "name": "🧰 Utilitaires",
      "tools": [
        {
          "name": "Netcat (nc)",
          "description": "Outil réseau polyvalent (écoute, connexion, transfert)",
          "command": "nc",
          "params": [
            {"id": "mode", "type": "dropdown", "label": "Mode", "options": ["-l (écoute)", "-v (client)", "-z (scan)"], "default": "-l (écoute)"},
            {"id": "port", "type": "text", "label": "Port", "placeholder": "4444", "default": "4444"},
            {"id": "target", "type": "text", "label": "Cible (client)", "placeholder": "192.168.1.1"}
          ]
        }
      ]
    },
    {
      "name": "🛠️ Personnalisés",
      "tools": [
        {
          "name": "Ping sweep",
          "description": "Scan ICMP d'une plage IP (perso)",
          "command": "ping",
          "params": [
            {"id": "range", "type": "text", "label": "Plage (ex: 192.168.1.1-254)", "placeholder": "192.168.1.1-254"}
          ]
        }
      ]
    }
  ]
}
