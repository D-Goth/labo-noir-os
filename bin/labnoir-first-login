#!/usr/bin/env bash
set -uo pipefail

# [DSK-09]
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/labnoir"
DONE="$STATE_DIR/first-login.done"
CONF="/etc/labnoir/labnoir.conf"
PREFIX="${LABNOIR_PREFIX:-/opt/labnoir}"
LOG="$STATE_DIR/first-login.log"

RESET="$STATE_DIR/first-login.reset"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

[[ -f "$DONE" ]] && exit 0
mkdir -p "$STATE_DIR"
exec >>"$LOG" 2>&1
echo "== $(date '+%F %T')"

# [DSK-12]
if [[ -f "$STATE_DIR/theme" && ! -f "$RESET" ]]; then
    echo "bureau déjà personnalisé : rien n'est modifié"
    touch "$DONE"
    exit 0
fi

# [DSK-13]
SAVE="$STATE_DIR/sauvegardes/$(date '+%F_%H%M%S')"
mkdir -p "$SAVE"
for f in plasma-org.kde.plasma.desktop-appletsrc plasmashellrc kdeglobals kwinrc konsolerc orbitpixelrc; do
    [[ -f "$CFG/$f" ]] && cp -a "$CFG/$f" "$SAVE/"
done
echo "configuration précédente sauvegardée dans $SAVE"

conf() { [[ -f "$CONF" ]] && sed -n "s|^$1=||p" "$CONF" | tail -n1; }

sleep 4

if command -v plasma-apply-lookandfeel >/dev/null 2>&1; then
    plasma-apply-lookandfeel --apply fr.blacklab.labonoir --resetLayout || echo "look-and-feel non appliqué"
fi

theme="$(conf THEME)"
"$PREFIX/bin/labnoir-theme" apply --fond "${theme:-labonoir}" || echo "thème non appliqué"

if [[ "$(conf ORBIT_LAYOUT)" == 1 && -x "$PREFIX/widgets/orbitpixel/place-layout.sh" ]]; then
    sleep 2
    "$PREFIX/widgets/orbitpixel/place-layout.sh" 'screenGeometry(desktops()[0].screen).width' || echo "Orbit Pixel non placé"
fi

rm -f "$RESET"
touch "$DONE"
